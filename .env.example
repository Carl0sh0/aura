# Copy this file to ".env" for local dev and add the same values as
# Environment Variables in the Vercel project for production. Aura's AI
# itself needs none of this — it runs entirely on-device. These only power
# optional, clearly-labeled extras (sign-in, reminders, backup).

# Optional: Google Sign-In (Settings > Account, and the encrypted backup
# feature). Get an OAuth Web client ID from Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# Optional: email capture on the welcome/download screen. Any endpoint that
# accepts a POSTed { email } JSON body (e.g. a Formspree form endpoint).
VITE_SUBSCRIBE_ENDPOINT=

# Daily reminder push notifications (api/push/*). Generate a keypair once
# with `npx web-push generate-vapid-keys`. The public key is duplicated under
# VITE_ so the browser can read it too — that's expected, public keys are
# meant to be public.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=

# Storage for push subscriptions and encrypted backup blobs (api/_lib/redis.ts).
# Free tier at upstash.com — create a Redis database, copy its REST URL/token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret between the GitHub Actions reminder cron and
# api/push/send-reminders.ts. Any long random string — not typed by a human.
CRON_SECRET=

# Password for the hidden /admin usage dashboard (api/analytics/stats.ts).
# Separate from CRON_SECRET on purpose: this one's typed by a person, so it
# can be short and memorable without weakening the cron's auth.
ADMIN_SECRET=
